# ==============================================================================
# TUMKUR EVENTS — ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# This template documents environment variables used for production deployment.
# Never commit real API keys, credentials, or private secrets to version control.
# Copy this file to .env.local for local overrides.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Canonical Site URL & Metadata Origin
# ------------------------------------------------------------------------------
# Used for Open Graph tags, canonical URLs, sitemaps, and robots.txt.
# Default fallback: https://tumkurevents.com
NEXT_PUBLIC_SITE_URL=https://tumkurevents.com

# ------------------------------------------------------------------------------
# 2. Studio Contact Configuration (Optional Overrides)
# ------------------------------------------------------------------------------
# Centralized defaults exist in src/config/site.ts and src/config/footer.ts.
# Format: International format without plus sign or spaces (e.g. 919481234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=919481234567
NEXT_PUBLIC_CONTACT_EMAIL=concierge@tumkurevents.com

# ------------------------------------------------------------------------------
# 3. Future Server-Side Integrations (Do NOT add NEXT_PUBLIC prefix)
# ------------------------------------------------------------------------------
# In future phases when the client integrates Gemini AI for the concierge assistant
# or an email submission provider (e.g. Resend), store private credentials here.
# These variables MUST remain strictly server-side and NEVER be prefixed with NEXT_PUBLIC.
#
# GEMINI_API_KEY=your_gemini_api_key_here
# RESEND_API_KEY=your_resend_api_key_here
